{
  "name": "vyaparmedia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:theme": "node scripts/verify-theme-consistency.mjs",
    "lint:actions": "node scripts/verify-action-buttons.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run lint:theme && npm run lint:actions && npm run typecheck && npm run db:verify-rls && npx prisma validate",
    "deploy:check": "npm run validate && npm run test && npm run build",
    "seed": "npx tsx -r ./scripts/mock-server-only.js scripts/seed-test-accounts.ts",
    "cron:verify": "npx tsx scripts/verify-qstash-crons.ts",
    "cron:sync": "npx tsx scripts/setup-qstash-crons.ts",
    "db:verify-rls": "npx tsx scripts/verify-database-rls.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "@sentry/cli": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@upstash/qstash": "^2.12.0",
    "autoprefixer": "^10.6.0",
    "bcryptjs": "^3.0.3",
    "compromise": "^14.18.0",
    "date-fns": "^4.1.0",
    "disposable-email-domains": "^1.0.62",
    "framer-motion": "^14.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.45.0",
    "next": "^16.2.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "postcss": "^8.5.28",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "swr": "^2.4.2",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.2.6",
    "prisma": "^7.10.0",
    "typescript": "^5",
    "vite": "^6.4.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
