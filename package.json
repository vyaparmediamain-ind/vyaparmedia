{
  "name": "vyaparmedia",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:theme": "node scripts/verify-theme-consistency.mjs",
    "lint:actions": "node scripts/verify-action-buttons.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ratchet": "npm run test:coverage && node scripts/coverage-ratchet.mjs",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run --project=dom",
    "test:routes": "vitest run tests/routes tests/unit/api*",
    "test:connections": "vitest run tests/contracts tests/unit/api-client-coverage.test.ts",
    "test:resilience": "vitest run tests/resilience",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "validate": "npm run lint && npm run lint:theme && npm run lint:actions && npm run typecheck && npm run db:verify-rls && npx prisma validate",
    "deploy:check": "npm run validate && npm run test && npm run build",
    "release:check": "npm run validate && npm test && npm run test:resilience && npm run knip && npm run audit:connections && npm run audit:routes",
    "seed": "npx tsx --conditions=react-server scripts/seed-test-accounts.ts",
    "cron:verify": "npx tsx scripts/verify-qstash-crons.ts",
    "cron:sync": "npx tsx scripts/setup-qstash-crons.ts",
    "flags:sync": "npx tsx --conditions=react-server scripts/sync-feature-flags-defaults.ts",
    "db:verify-rls": "npx tsx scripts/verify-database-rls.ts",
    "load-test": "node load-tests/run-autocannon.mjs",
    "load-test:k6": "k6 run load-tests/k6-read-heavy.js",
    "load-test:explain": "npx tsx load-tests/explain-analyze-scenarios.ts",
    "knip": "knip",
    "audit:routes": "npx tsx scripts/audit/route-manifest.ts",
    "audit:connections": "npx tsx scripts/audit/connections.ts",
    "audit:tests": "npx tsx scripts/audit/test-matrix.ts",
    "audit:fallbacks": "npx tsx scripts/audit/fallbacks.ts",
    "audit:guides": "npx tsx scripts/audit/guide-coverage.ts",
    "audit:guide-docs": "npx tsx scripts/audit/generate-guide-docs.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "@sentry/cli": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.12",
    "@upstash/qstash": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "compromise": "^14.18.0",
    "date-fns": "^4.1.0",
    "disposable-email-domains": "^1.0.62",
    "framer-motion": "^14.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.45.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "postcss": "^8.5.28",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "19.2.6",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "swr": "^2.4.2",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autocannon": "^8.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.5.4",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "typescript": "^5",
    "vite": "^6.4.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3",
    "sharp": "^0.35.5",
    "axios": "^1.21.1",
    "follow-redirects": "^1.16.3",
    "source-map-js": "^1.2.4",
    "fast-xml-parser": "^5.12.1"
  }
}
