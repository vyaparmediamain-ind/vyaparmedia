// ==================== SECURITY & LOGGING ====================

// AuditLog is APPEND-ONLY — protected by trg_immutable_audit_log DB trigger.
// updatedAt is intentionally absent: Prisma's @updatedAt would auto-issue an UPDATE
// on upsert, which the immutability trigger would block with an exception.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actionType String // e.g. "ADMIN_OVERRIDE", "DISPUTE_RESOLUTION"
  entityType String // e.g. "Deal", "Wallet"
  entityId   String
  beforeJSON Json?
  afterJSON  Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  // Composite DESC index: admin audit trail pagination
  // WHERE entityType='Deal' AND entityId=X ORDER BY timestamp DESC
  @@index([entityType, entityId, timestamp(sort: Desc)])
  @@index([actorId, timestamp(sort: Desc)])
  @@index([timestamp])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String? // Campaign, Deal, etc.
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, action, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

