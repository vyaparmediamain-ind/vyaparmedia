// Influencer Marketplace - Database Schema
// Phase 1: Foundation & Core

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// CONNECTION SETUP — READ CAREFULLY BEFORE CHANGING
// ==============================================================================
// At 10-lakh-user scale on serverless (Vercel), two separate URLs are required:
//
//   DATABASE_URL  → Supavisor pooler (transaction mode, port 6543)
//     postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
//     ?pgbouncer=true&connection_limit=1
//     • Used by the Next.js app at runtime.
//     • connection_limit=1 is CRITICAL for serverless — each lambda must not
//       open more than 1 connection to the pooler.
//     • pool_mode MUST be "transaction" (set on Supabase dashboard).
//       Session mode does not work with Prisma on serverless.
//
//   DIRECT_URL    → Direct Postgres (port 5432, session mode)
//     postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
//     • Used only by `prisma migrate` and `prisma db push` (DDL operations).
//     • Never used at runtime — session-mode DDL requires a direct connection.
//
// Wrong setup → serverless connection exhaustion crash ("too many connections")
// ==============================================================================
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // Supavisor pooler — port 6543, pgbouncer=true
  directUrl = env("DIRECT_URL")    // Direct connection — port 5432, migrations only
}

// ==================== USER MANAGEMENT ====================

enum UserType {
  INFLUENCER
  BRAND
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  FLAGGED
  DELETED
}

enum VerificationLevel {
  NONE
  BASIC // Phone + Email
  IDENTITY // PAN + Bank verified
  FULL // All verifications complete
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  phone             String?           @unique
  passwordHash      String
  userType          UserType
  status            UserStatus        @default(PENDING_VERIFICATION)
  verificationLevel VerificationLevel @default(NONE)
  emailVerified     Boolean           @default(false)
  phoneVerified     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime? // Soft delete for compliance

  // Security & Audit
  lastLoginAt         DateTime?
  lastPasswordChange  DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  isTwoFactorEnabled  Boolean   @default(false)
  twoFactorSecret     String?
  twoFactorRecoveryCodes String?

  // Relations
  influencerProfile       InfluencerProfile?
  brandProfile            BrandProfile?
  oauthAccounts           OAuthAccount[]
  oauthStates             OAuthState[]
  verificationDocs        VerificationDocument[]
  taxCompliance           IndiaTaxCompliance?
  wallet                  Wallet?
  sentMessages            Message[]              @relation("SentMessages")
  receivedMessages        Message[]              @relation("ReceivedMessages")
  notifications           Notification[]
  activityLogs            ActivityLog[]
  bankAccounts            BankAccount[]
  disputes                Dispute[]
  violations              UserViolation[]
  reviewsWritten          Review[]               @relation("Reviewer")
  reviewsReceived         Review[]               @relation("ReviewReceiver")
  notificationPreferences Json?                  @default("{\"email\":{\"marketing\":true,\"updates\":true,\"security\":true}}")
  pushSubscriptions       PushSubscription[]
  creditorClaims          DebtClaim[]            @relation("CreditorUser")
  blocksSent              UserBlock[]            @relation("UserBlocksSent")
  blocksReceived          UserBlock[]            @relation("UserBlocksReceived")
  reportsSent             UserReport[]           @relation("UserReportsSent")
  reportsReceived         UserReport[]           @relation("UserReportsReceived")

  // Gamification
  xp                Int                     @default(0)
  level             Int                     @default(1)
  badges            UserBadge[]
  challengeProgress UserChallengeProgress[]
  referralCode      String                  @unique @default(cuid())
  referredBy        String?
  referredUsers     User[]                  @relation("Referrals")
  referrer          User?                   @relation("Referrals", fields: [referredBy], references: [id])

  // Trust & Security
  trustScore         Int                 @default(600)
  deviceFingerprints DeviceFingerprint[]
  loginAttempts      LoginAttempt[]
  scoreSnapshots     DrsScoreSnapshot[]
  reviewFlagsAsInfluencer ReviewFlagRecord[] @relation("InfluencerFlags")
  reviewFlagsAsBrand      ReviewFlagRecord[] @relation("BrandFlags")

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  refreshTokens RefreshToken[]
  otpTokens     OtpToken[]

  @@index([userType, status])
  @@index([email])
  @@index([referralCode])
  @@index([referredBy])
  @@index([createdAt])
  @@index([updatedAt])
}

model RefreshToken {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  createdAt       DateTime @default(now())
  replacedByToken String?

  @@index([userId])
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String // instagram, youtube, google
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id        String   @id @default(cuid())
  userId    String
  state     String
  provider  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([state])
  @@index([userId])
  @@index([expiresAt]) // L3 FIX: cleanup-oauth cron filters by expiresAt; without this index, it causes full table scans
}

model LoginAttempt {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean  @default(false)
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model DeviceFingerprint {
  id           String   @id @default(cuid())
  userId       String
  fingerprint  String
  lastIp       String
  lastLocation String?
  userAgent    String?
  isTrusted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
}

// ==================== PROFILES ====================

model InfluencerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  bio         String?
  avatar      String?
  city        String?
  state       String?
  address     String?
  pinCode     String?

  // Demographics
  gender String?
  age    Int?

  // Social Media Stats
  instagramHandle         String?
  instagramFollowers      Int?
  instagramEngagementRate Float? // Basis points
  youtubeHandle           String?
  youtubeSubscribers      Int?
  youtubeEngagementRate   Float? // Basis points

  // Categories & Niches
  categories String // fashion, food, tech, etc. (comma separated)
  languages  String // hindi, english, etc. (comma separated)

  // Rates (paise)
  minRate Int?
  maxRate Int?
  minInstagramRate Int?
  maxInstagramRate Int?
  minYoutubeRate   Int?
  maxYoutubeRate   Int?

  // Verification Scores (Rule-based)
  followerAuthenticityScore Int       @default(50) // 0-100
  contentQualityScore       Int       @default(50) // 0-100
  accountAge                DateTime?

  // Featured Status (Weekly Challenge Reward)
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  // Stats
  totalDeals     Int @default(0)
  completedDeals Int @default(0)
  averageRating  Int @default(0) // 0-500 (5.00)
  totalEarnings  Int @default(0)
  totalReviews   Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
  deals            Deal[]        @relation("InfluencerDeals")
  reviews          Review[]      @relation("InfluencerReviews")
  createdCampaigns Campaign[]    @relation("CreatedCampaigns")

  @@index([totalDeals])
  @@index([minRate])
  @@index([instagramHandle])
  @@index([youtubeHandle])
  @@index([isFeatured])
  @@index([categories, instagramFollowers])
  @@index([city, instagramFollowers])
  @@index([minRate, maxRate])
  @@index([isFeatured, instagramFollowers(sort: Desc), averageRating(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
}

model BrandProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  logo        String?
  website     String?
  description String?
  industry    String?
  city        String?
  state       String?
  address     String?
  pinCode     String?

  // Verification (PII - Requires Encryption in Transit/Rest)
  /// @encrypted
  gstNumber     String?
  /// @encrypted
  panNumber     String?
  /// @encrypted
  cinNumber     String?
  isGstVerified Boolean @default(false)
  isPanVerified Boolean @default(false)
  isCinVerified Boolean @default(false)

  // Stats
  totalCampaigns  Int @default(0)
  activeCampaigns Int @default(0)
  totalSpent      Int @default(0)
  averageRating   Int @default(0) // 0-500 (5.00)
  totalReviews    Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  deals     Deal[]     @relation("BrandDeals")
  reviews   Review[]   @relation("BrandReviews")

  @@index([deletedAt])
  @@index([industry])
  @@index([city])
}

// ==================== VERIFICATION ====================

enum DocumentType {
  PAN_CARD
  AADHAAR
  GST_CERTIFICATE
  CIN_CERTIFICATE
  BANK_STATEMENT
  SELFIE
  MSME_CERTIFICATE
  STARTUP_CERTIFICATE
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model VerificationDocument {
  id                 String         @id @default(cuid())
  userId             String
  type               DocumentType
  documentUrl        String
  /// @encrypted
  documentNumber     String?
  documentNumberHash String?
  status             DocumentStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
  @@index([documentNumberHash])
  @@index([type, documentNumberHash])
}

model IndiaTaxCompliance {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  /// @encrypted
  panNumber                String?
  panLast4                 String?
  panNumberHash            String?
  /// @encrypted
  gstin                    String?
  gstinLast4               String?
  gstStateCode             String?
  gstRegistrationType      String    @default("UNREGISTERED")
  gstTurnoverSlab          String?
  /// @encrypted
  itrAcknowledgementNumber String?
  itrAcknowledgementLast4  String?
  itrAssessmentYear        String?
  tdsSection               String?
  eInvoiceApplicable       Boolean   @default(false)
  status                   String    @default("ACTION_REQUIRED")
  submittedAt              DateTime?
  verifiedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([gstRegistrationType])
  @@index([eInvoiceApplicable])
  @@index([panNumberHash])
}

model TrustRuleConfig {
  id          String   @id @default(cuid())
  ruleKey     String   @unique
  category    String   // INFLUENCER, BRAND, FRAUD, GENERAL
  weight      Float
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ==================== CAMPAIGNS ====================

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ContentType {
  INSTAGRAM_POST
  INSTAGRAM_REEL
  INSTAGRAM_STORY
  YOUTUBE_VIDEO
  YOUTUBE_SHORT
}

model Campaign {
  id           String  @id @default(cuid())
  brandId      String?
  influencerId String? // ADDED: Allow influencers to create campaigns (e.g. collabs)

  title        String
  description  String
  requirements String
  guidelines   String?

  // Budget
  totalBudget         Int  @default(0)
  perInfluencerBudget Int?
  /// @deprecated Replaced by reservedTotalAmount. Scheduled for migration removal in release v2.2.
  reservedAmount      Int  @default(0)
  fundedAmount        Int  @default(0)
  reservedTotalAmount Int  @default(0)

  // Targeting (Changed from Comma-separated Strings to PostgreSQL Arrays for indexing)
  targetCategories  String[]
  targetCities      String[]
  targetLanguages   String[]
  targetGender      String? // "MALE", "FEMALE", "ANY"
  targetAgeMin      Int?
  targetAgeMax      Int?
  minFollowers      Int      @default(5000)
  maxFollowers      Int?
  minEngagementRate Int? // Basis points

  // Deliverables
  deliverables Json // Array of {type, count, specs}

  // Product Seeding
  requiresProduct    Boolean @default(false)
  productName        String?
  productValue       Int? // Value of the product (paise)
  productDescription String?

  // Timeline
  applicationDeadline DateTime?
  contentDeadline     DateTime
  postingDeadline     DateTime

  // Status
  status         CampaignStatus @default(DRAFT)
  isDirectInvite Boolean        @default(false)

  // Stats
  totalApplications   Int @default(0)
  selectedInfluencers Int @default(0)
  maxInfluencers      Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand        BrandProfile?      @relation(fields: [brandId], references: [id])
  influencer   InfluencerProfile? @relation("CreatedCampaigns", fields: [influencerId], references: [id]) // Relation
  applications Application[]
  deals        Deal[]

  @@index([status])
  @@index([createdAt])
  @@index([totalBudget])
  @@index([brandId])
  @@index([influencerId])
  @@index([status, applicationDeadline, totalBudget]) // ADDED: Composite filtering
  @@index([brandId, status, deletedAt])
  @@index([status, deletedAt])
  @@index([status, deletedAt, createdAt(sort: Desc)])
  @@index([status, deletedAt, perInfluencerBudget, createdAt(sort: Desc)])
  @@index([brandId, deletedAt, createdAt(sort: Desc)])
  // Brand dashboard: WHERE brandId=X AND status=Y AND deletedAt IS NULL ORDER BY createdAt DESC
  // Previously required Postgres to merge two separate indexes — now single index scan
  @@index([brandId, status, deletedAt, createdAt(sort: Desc)])
}

// ==================== APPLICATIONS & DEALS ====================

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
  FLAGGED
}

model Application {
  id           String @id @default(cuid())
  campaignId   String
  influencerId String

  proposal          String
  proposedRate      Int       @default(0)
  estimatedDelivery DateTime?

  status          ApplicationStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, influencerId])
  @@index([status])
  @@index([campaignId])
  @@index([influencerId])
  @@index([campaignId, status, deletedAt])
  @@index([influencerId, status, deletedAt])
  @@index([campaignId, status, deletedAt, createdAt(sort: Desc)])
  @@index([influencerId, status, deletedAt, createdAt(sort: Desc)])
  @@index([campaignId, deletedAt, createdAt(sort: Desc)])
}

enum DealStatus {
  PENDING_SIGNATURE
  PAYMENT_PENDING
  PAYMENT_HELD
  ACTIVE
  CONTENT_SUBMITTED
  REVISION_REQUESTED
  CONTENT_APPROVED
  POSTED
  VERIFICATION_PENDING
  VERIFIED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ProductFulfillmentStatus {
  NOT_REQUIRED
  ADDRESS_PENDING
  READY_TO_DISPATCH
  DISPATCHED
  RECEIVED
}

model Deal {
  id           String  @id @default(cuid())
  campaignId   String
  influencerId String
  brandId      String?

  // Contract Terms
  amount      Int @default(0)
  platformFee Int @default(0)
  gatewayFee  Int @default(0)
  /// @deprecated Canonical financial field is amount (in paise). Scheduled for migration removal in release v2.2.
  totalAmount Int @default(0)
  influencerPayout Int?
  reservedFromWallet Boolean @default(false)

  // Tax fields (populated at deal completion for reporting)
  tdsDeducted Int @default(0)  // TDS amount in paise (0 if below 194-O threshold)
  grossPayout Int @default(0)  // Influencer gross before TDS
  netPayout   Int @default(0)  // Influencer net after TDS

  contractTerms     Json // Full contract details
  contractSignature Json? // Digital signatures from both parties

  // Product Seeding Lifecycle
  requiresProduct          Boolean                  @default(false)
  productName              String?
  productValue             Int?
  productHandlingFee       Int                      @default(0)
  productFulfillmentStatus ProductFulfillmentStatus @default(NOT_REQUIRED)
  shippingAddress          Json?
  dispatchTrackingNumber   String?
  dispatchCarrier          String?
  dispatchedAt             DateTime?
  productReceivedAt        DateTime?

  // Shiprocket Shipping Integration
  shippingOrderId          String?
  shippingShipmentId       String?
  shippingAwbCode          String?
  shippingLabelUrl         String?
  shippingManifestUrl      String?
  shippingStatus           String?
  shippingCourierName      String?
  shippingTrackingHistory  Json?
  shippingChargeAmount     Int?    // Courier charge billed to brand wallet (paise). Null = not yet billed.

  // Timeline
  submissionDeadline DateTime
  reviewPeriodHours  Int      @default(48)
  postingDeadline    DateTime

  // Status Tracking
  status DealStatus @default(PENDING_SIGNATURE)
  reconcileFailures Int @default(0)

  // Signatures
  brandSignedAt      DateTime?
  influencerSignedAt DateTime?

  // Content
  /// @deprecated Replaced by ContentSubmission model (supports multi-item deliverables). Scheduled for migration removal in release v2.2.
  submittedContentUrl String?
  /// @deprecated Tracked via ContentSubmission.createdAt. Scheduled for migration removal in release v2.2.
  submittedAt         DateTime?

  // Revisions
  revisionsUsed Int @default(0)
  maxRevisions  Int @default(2)

  // Approval
  approvedAt      DateTime?
  rejectionReason String?

  // Posting
  postUrl  String?
  postedAt DateTime?

  // Verification
  requiresPostVerification Boolean   @default(true)
  verifiedAt             DateTime?
  verificationScreenshot String?
  verificationHash       String?

  startedAt DateTime?

  // Post Monitoring
  isPostAlive              Boolean   @default(true)
  lastPostCheck            DateTime?
  postCheckCount           Int       @default(0)
  consecutiveMissingChecks Int       @default(0)

  // Completion
  completedAt DateTime?
  signDeadline DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaign   Campaign          @relation(fields: [campaignId], references: [id])
  influencer InfluencerProfile @relation("InfluencerDeals", fields: [influencerId], references: [id])
  brand      BrandProfile?     @relation("BrandDeals", fields: [brandId], references: [id])

  messages            Message[]
  paymentHold         PaymentHold?
  transactions        Transaction[]
  disputes            Dispute[]
  reviews             Review[]
  contentSubmissions  ContentSubmission[]
  engagementSnapshots EngagementSnapshot[]
  debtClaims          DebtClaim[]

  @@index([status])
  @@index([campaignId])
  @@index([influencerId])
  @@index([brandId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([productFulfillmentStatus])
  @@index([brandId, status, deletedAt])
  @@index([influencerId, status, deletedAt])
  @@index([campaignId, status, deletedAt])
  @@index([status, signDeadline, deletedAt])
  @@index([status, completedAt, deletedAt])
  @@index([status, isPostAlive])
  @@index([completedAt])              // FY range queries
  @@index([influencerId, completedAt]) // Influencer income summary (all-time)
  @@index([brandId, completedAt])     // Brand spend by FY (all-time)
  // Composite FY range: WHERE influencerId=X AND status='COMPLETED' AND completedAt >= startOfFY
  // Covers: monthly/quarterly earnings, analytics dashboard — avoids seq-scan on large tables
  @@index([influencerId, status, completedAt])
  // Composite FY range: WHERE brandId=X AND status='COMPLETED' AND completedAt >= startOfFY
  @@index([brandId, status, completedAt])
  @@index([brandId, status, deletedAt, createdAt(sort: Desc)])
  @@index([influencerId, status, deletedAt, createdAt(sort: Desc)])
  @@index([brandId, deletedAt, createdAt(sort: Desc)])
  @@index([influencerId, deletedAt, createdAt(sort: Desc)])
  @@index([campaignId, status, deletedAt, createdAt(sort: Desc)])
}

model ContentSubmission {
  updatedAt   DateTime  @updatedAt
  id          String    @id @default(cuid())
  dealId      String
  version     Int       @default(1)
  contentUrl  String
  contentUrls Json?
  notes       String?
  status      String    @default("PENDING") // PENDING, APPROVED, REVISION_REQUESTED
  feedback    String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ==================== PAYMENTS ====================

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Int      @default(0) // In paise
  pendingBalance Int      @default(0)
  totalEarned    Int      @default(0)
  totalWithdrawn Int      @default(0)
  totalDeposited Int      @default(0)
  totalSpent     Int      @default(0)
  debt           Int      @default(0)
  isFrozen       Boolean  @default(false)
  frozenReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  withdrawals  Withdrawal[]
  debtorClaims DebtClaim[]   @relation("DebtorWallet")
}

enum TransactionType {
  CREDIT
  DEBIT
  WITHDRAWAL
  REFUND
  CLAWBACK
  PLATFORM_FEE
  CHARGEBACK
  SHIPPING_CHARGE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Transaction {
  deletedAt         DateTime?
  id                String            @id @default(cuid())
  walletId          String
  dealId            String?
  withdrawalId      String?
  type              TransactionType
  amount            Int               @default(0)
  status            TransactionStatus @default(PENDING)
  description       String?
  metadata          Json?
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  wallet     Wallet      @relation(fields: [walletId], references: [id])
  deal       Deal?       @relation(fields: [dealId], references: [id])
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([walletId, status])
  @@index([walletId, type, createdAt])
  @@index([walletId, status, createdAt])
  @@index([dealId])
  @@index([withdrawalId])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([type, status, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([walletId, deletedAt, createdAt])
  @@index([walletId, status, deletedAt, createdAt])
  @@index([walletId, createdAt(sort: Desc)], map: "Transaction_walletId_createdAt_desc_idx")
  @@index([walletId, deletedAt, createdAt(sort: Desc)], map: "Transaction_walletId_deletedAt_createdAt_desc_idx")
  @@index([walletId, status, deletedAt, createdAt(sort: Desc)], map: "Transaction_walletId_status_deletedAt_createdAt_desc_idx")
}

enum PaymentHoldStatus {
  PENDING
  HELD
  CAPTURED
  RELEASED
  EXPIRED
  FAILED
}

model PaymentHold {
  id                String            @id @default(cuid())
  dealId            String            @unique
  razorpayOrderId   String            @unique
  razorpayPaymentId String?
  amount            Int               @default(0)
  status            PaymentHoldStatus @default(PENDING)
  expiresAt         DateTime
  capturedAt        DateTime?
  releasedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([status])
  @@index([expiresAt])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PENDING_REVIEW
  REVERSED
}

model Withdrawal {
  id                String           @id @default(cuid())
  walletId          String
  amount            Int              @default(0)
  /// @deprecated Replaced by verified BankAccount relation (penny-drop validation). Kept for historical audit. Scheduled for migration removal in release v2.2.
  bankAccountName   String
  /// @encrypted
  /// @deprecated Replaced by verified BankAccount relation (penny-drop validation). Kept for historical audit. Scheduled for migration removal in release v2.2.
  bankAccountNumber String
  /// @deprecated Kept for historical duplicate detection. Scheduled for migration removal in release v2.2.
  bankAccountHash   String?          // Deterministic HMAC for efficient duplicate detection
  /// @deprecated Replaced by verified BankAccount relation (penny-drop validation). Kept for historical audit. Scheduled for migration removal in release v2.2.
  ifscCode          String
  /// @encrypted
  /// @deprecated Replaced by verified BankAccount relation (penny-drop validation). Kept for historical audit. Scheduled for migration removal in release v2.2.
  upiId             String?
  /// @deprecated Kept for historical duplicate detection. Scheduled for migration removal in release v2.2.
  upiIdHash         String?          // Deterministic HMAC for efficient duplicate detection
  status            WithdrawalStatus @default(PENDING)
  razorpayPayoutId  String?
  processedAt       DateTime?
  failureReason     String?
  adminNotes        String?
  isManualReview    Boolean          @default(false)
  riskScore         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  wallet       Wallet        @relation(fields: [walletId], references: [id])
  transactions Transaction[]

  @@index([walletId])
  @@index([status])
  @@index([walletId, createdAt])
  @@index([createdAt])
  @@index([bankAccountHash])
  @@index([upiIdHash])
  @@index([walletId, createdAt(sort: Desc)], map: "Withdrawal_walletId_createdAt_desc_idx")
  @@index([walletId, status, createdAt(sort: Desc)], map: "Withdrawal_walletId_status_createdAt_desc_idx")
  @@index([status, createdAt(sort: Desc)], map: "Withdrawal_status_createdAt_desc_idx")
}

model BankAccount {
  deletedAt     DateTime?
  id            String    @id @default(cuid())
  userId        String
  accountName   String
  /// @encrypted
  accountNumber String
  accountNumberHash String?
  ifscCode      String
  bankName      String
  /// @encrypted
  upiId         String?
  upiIdHash     String?
  isDefault     Boolean   @default(false)
  isVerified    Boolean   @default(false) // Set to true after Razorpay Fund Account Validation (penny-drop)
  verifiedAt    DateTime?                 // Timestamp of successful verification
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountNumberHash])
  @@index([upiIdHash])
  @@index([userId, deletedAt])
}

// ==================== DISPUTES ====================

enum DisputeType {
  QUALITY
  TIMELINE
  PAYMENT
  CONTENT_DELETED
  TERMS_VIOLATION
  OTHER
}

enum DisputeStatus {
  OPEN
  TIER1_AUTO
  TIER2_MEDIATION
  TIER3_ARBITRATION
