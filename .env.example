# ==============================================================================
# DECISIONAL / VYAPARMEDIA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Replace all placeholder values marked with [REPLACE] with your credentials.
# 3. For cryptographic secrets marked with [GENERATE], run: openssl rand -hex 32
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & NETWORK
# ==============================================================================
NODE_ENV="development"
PORT=3000

# Base URLs (Used for callbacks, auth redirects, and absolute asset URLs)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Allowed dev host origins (Supports local IP testing on mobile/LAN)
ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"

# Log level: debug | info | warn | error
LOG_LEVEL="info"


# ==============================================================================
# 2. DATABASE (SUPABASE / POSTGRESQL)
# ==============================================================================
# [REPLACE] Primary PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# [OPTIONAL] Supabase Transaction Pooler URL (Port 6543) - Recommended for Vercel deployment
# Must include pgbouncer=true to prevent connection pool exhaustion
PGBOUNCER_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# [OPTIONAL] Prisma Accelerate URL (Alternative to PgBouncer)
PRISMA_ACCELERATE_URL=""


# ==============================================================================
# 3. REDIS CACHE & RATE LIMITING (UPSTASH)
# ==============================================================================
# [REPLACE] Redis connection string for distributed caching, locks & rate limiting
# Local: redis://127.0.0.1:6379
# Production: rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379
REDIS_URL="redis://127.0.0.1:6379"

# [OPTIONAL] Upstash Edge REST API (Required for Edge Middleware IP blacklisting)
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_HOST.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"


# ==============================================================================
# 4. AUTHENTICATION & SECURITY TOKENS
# ==============================================================================
# [GENERATE] Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# [REPLACE] Google OAuth 2.0 Credentials (From Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"


# ==============================================================================
# 5. PAYMENTS & ESCROW (RAZORPAY & RAZORPAYX)
# ==============================================================================
# [REPLACE] Razorpay API Keys (rzp_test_... for Sandbox, rzp_live_... for Live)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# [REPLACE] Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# [OPTIONAL] RazorpayX Account Number (Required in production for automated payouts)
RAZORPAY_ACCOUNT_NUMBER="YOUR_RAZORPAY_ACCOUNT_NUMBER"


# ==============================================================================
# 6. TRANSACTIONAL EMAIL (RESEND)
# ==============================================================================
# [REPLACE] Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
FROM_EMAIL="noreply@yourdomain.com"
REPLY_TO_EMAIL="support@yourdomain.com"


# ==============================================================================
# 7. SMS & WHATSAPP OTP (MSG91 / TWILIO / META)
# ==============================================================================
# OTP Channel Strategy: "whatsapp" (primary) with SMS fallback, or "sms"
OTP_PRIMARY_CHANNEL="whatsapp"
OTP_SMS_FALLBACK="true"

# [OPTIONAL] MSG91 for SMS OTP (DLT-approved templates)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DCSNL"
MSG91_TEMPLATE_ID=""

# [OPTIONAL] WhatsApp Provider: "auto" | "twilio" | "meta"
WHATSAPP_PROVIDER="auto"

# Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta Cloud API WhatsApp Credentials
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"


# ==============================================================================
# 8. CLOUD STORAGE (CLOUDFLARE R2 / AWS S3)
# ==============================================================================
# Storage Provider: "local" (for local dev) | "r2" (Cloudflare) | "s3" (AWS)
STORAGE_PROVIDER="local"

# S3 / R2 Configuration (Required when STORAGE_PROVIDER is "r2" or "s3")
S3_BUCKET="decisional-prod"
S3_REGION="auto"
S3_ACCESS_KEY="YOUR_R2_ACCESS_KEY_ID"
S3_SECRET_KEY="YOUR_R2_SECRET_ACCESS_KEY"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_PUBLIC_URL="https://cdn.yourdomain.com"
R2_PUBLIC_URL="https://cdn.yourdomain.com"


# ==============================================================================
# 9. IDENTITY & KYC VERIFICATION
# ==============================================================================
# Provider: "manual" (Admin review) | "surepass" (Automated PAN/Aadhaar)
KYC_PROVIDER="manual"
KYC_API_KEY=""

# [OPTIONAL] DigiLocker OAuth Credentials
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""


# ==============================================================================
# 10. SOCIAL MEDIA PLATFORM APIS
# ==============================================================================
# [OPTIONAL] Instagram Graph API (Meta for Developers)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# [OPTIONAL] YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=""


# ==============================================================================
# 11. CRYPTOGRAPHY, ENCRYPTION & SYSTEM KEYS
# ==============================================================================
# [GENERATE] AES-256-GCM Encryption Key Map for bank details (v1:<64-hex-characters>)
ENCRYPTION_KEYS="v1:YOUR_64_HEX_KEY"
ENCRYPTION_KEY="YOUR_64_HEX_KEY"

# [GENERATE] HMAC Signature Secret for tamper-proof data verification (64 hex chars)
HMAC_KEY="YOUR_64_HEX_HMAC_KEY"

# [GENERATE] Digital Contract Signing Secret (64 hex chars)
CONTRACT_SIGNING_SECRET="generate-with: openssl rand -hex 32"
SIGNING_SECRET="generate-with: openssl rand -hex 32"

# [GENERATE] Automated Cron Route Secret (Protects /api/cron/* endpoints)
CRON_SECRET="generate-with: openssl rand -hex 32"

# [GENERATE] System Healthcheck & Metrics Auth Tokens
HEALTHCHECK_SECRET="generate-with: openssl rand -hex 32"
PROMETHEUS_AUTH_TOKEN="generate-with: openssl rand -hex 32"


# ==============================================================================
# 12. ERROR TRACKING & PERFORMANCE MONITORING (SENTRY)
# ==============================================================================
# [OPTIONAL] Sentry DSN for error and performance monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"


# ==============================================================================
# 13. PLATFORM BUSINESS RULES & THRESHOLDS
# ==============================================================================
PLATFORM_FEE_PERCENTAGE=10
GATEWAY_FEE_PERCENTAGE=2
MIN_WITHDRAWAL_AMOUNT=50000
MAX_WALLET_BALANCE=1000000000
ADMIN_EMAILS="admin@yourdomain.com"
