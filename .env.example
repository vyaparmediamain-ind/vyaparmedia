# ==============================================================================
# VYAPARMEDIA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Replace all placeholder values marked with [REPLACE] with your credentials.
# 3. For cryptographic secrets marked with [GENERATE], run: openssl rand -hex 32
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & NETWORK
# ==============================================================================
NODE_ENV="development"
PORT=3000

# Base URLs (Used for callbacks, auth redirects, and absolute asset URLs)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Allowed dev host origins (Supports local IP testing on mobile/LAN)
ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"

# Log level: debug | info | warn | error
LOG_LEVEL="info"


# ==============================================================================
# 2. DATABASE (SUPABASE / POSTGRESQL)
# ==============================================================================
# [REPLACE] Runtime PostgreSQL connection string (Supabase Supavisor Transaction Pooler - Port 6543)
# Must use transaction pooler with pgbouncer=true to prevent serverless connection-exhaustion crashes
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# [REPLACE] Direct connection string for Prisma migrations & DDL (Port 5432 - Session Mode)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# [OPTIONAL] Read Replica URL (For scaling search & discovery queries across 1M+ creators)
DATABASE_READ_REPLICA_URL=""

# [OPTIONAL] Backward compatibility alias
PGBOUNCER_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# [OPTIONAL] Prisma Accelerate URL (Alternative to PgBouncer)
PRISMA_ACCELERATE_URL=""

# [LOCAL DEV ONLY] Set to "true" to allow non-SSL database connections in local dev
ALLOW_INSECURE_DATABASE="false"

# [OPTIONAL] Slow database query logging threshold in milliseconds (default: 500)
DB_SLOW_QUERY_THRESHOLD_MS=500
SLOW_QUERY_THRESHOLD_MS=500


# ==============================================================================
# 3. REDIS CACHE & RATE LIMITING (UPSTASH)
# ==============================================================================
# [REPLACE] Redis connection string for distributed caching, locks & rate limiting
# Local: redis://127.0.0.1:6379
# Production: rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379
REDIS_URL="redis://127.0.0.1:6379"

# [OPTIONAL] Upstash Edge REST API (Required for Edge Middleware IP blacklisting)
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_HOST.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"


# ==============================================================================
# 4. UPSTASH QSTASH (BACKGROUND & CRON JOBS SCHEDULER)
# ==============================================================================
# [REPLACE] QStash Bearer Token for creating and managing recurring schedules via REST API
QSTASH_TOKEN="YOUR_QSTASH_TOKEN"

# [REPLACE] Signing keys used to cryptographically verify incoming webhook requests from QStash
QSTASH_CURRENT_SIGNING_KEY="YOUR_QSTASH_CURRENT_SIGNING_KEY"
QSTASH_NEXT_SIGNING_KEY="YOUR_QSTASH_NEXT_SIGNING_KEY"


# ==============================================================================
# 5. AUTHENTICATION & SECURITY TOKENS
# ==============================================================================
# [GENERATE] Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# [GENERATE] Dedicated HMAC salt secret for phone OTP hashes in Redis
OTP_HASH_SECRET="generate-with: openssl rand -hex 32"

# [DEV/E2E ONLY] Allow fixed OTP "123456" for automated testing (FORBIDDEN in production)
E2E_MAGIC_OTP="false"

# [REPLACE] Google OAuth 2.0 Credentials (From Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"


# ==============================================================================
# 6. PAYMENTS & ESCROW (RAZORPAY & RAZORPAYX)
# ==============================================================================
# [REPLACE] Razorpay API Keys (rzp_test_... for Sandbox, rzp_live_... for Live)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# [REPLACE] Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# [OPTIONAL] RazorpayX Account Number (Required in production for automated payouts)
RAZORPAY_ACCOUNT_NUMBER="YOUR_RAZORPAY_ACCOUNT_NUMBER"


# ==============================================================================
# 7. SUPABASE REALTIME (WEBSOCKET LIVE UPDATES & MESSAGING)
# ==============================================================================
# [REPLACE] Supabase Project URL and Anonymous Key for client-side websocket connections
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"


# ==============================================================================
# 8. TRANSACTIONAL EMAIL (RESEND)
# ==============================================================================
# [REPLACE] Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
FROM_EMAIL="noreply@yourdomain.com"
REPLY_TO_EMAIL="support@yourdomain.com"


# ==============================================================================
# 9. SMS & WHATSAPP OTP (MSG91 / TWILIO / META)
# ==============================================================================
# OTP Channel Strategy: "whatsapp" (primary) with SMS fallback, or "sms"
OTP_PRIMARY_CHANNEL="whatsapp"
OTP_SMS_FALLBACK="true"

# [OPTIONAL] MSG91 for SMS OTP (DLT-approved templates)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DCSNL"
MSG91_TEMPLATE_ID=""
SMS_API_KEY=""
SMS_SENDER_ID="DCSNL"

# [OPTIONAL] WhatsApp Provider: "auto" | "twilio" | "meta"
WHATSAPP_PROVIDER="auto"

# Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta Cloud API WhatsApp Credentials
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"


# ==============================================================================
# 10. WEB PUSH NOTIFICATIONS
# ==============================================================================
# [OPTIONAL] VAPID Public Key for browser push notification subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""


# ==============================================================================
# 11. CLOUD STORAGE (CLOUDFLARE R2 / AWS S3)
# ==============================================================================
# Storage Provider: "local" (for local dev) | "r2" (Cloudflare) | "s3" (AWS)
STORAGE_PROVIDER="local"

# S3 / R2 Configuration (Required when STORAGE_PROVIDER is "r2" or "s3")
S3_BUCKET="vyaparmedia-prod"
S3_REGION="auto"
S3_ACCESS_KEY="YOUR_R2_ACCESS_KEY_ID"
S3_SECRET_KEY="YOUR_R2_SECRET_ACCESS_KEY"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_PUBLIC_URL="https://cdn.yourdomain.com"
R2_PUBLIC_URL="https://cdn.yourdomain.com"


# ==============================================================================
# 12. IDENTITY & KYC VERIFICATION
# ==============================================================================
# Provider: "manual" (Admin review) | "surepass" (Automated PAN/Aadhaar)
KYC_PROVIDER="manual"
KYC_API_KEY=""

# [OPTIONAL] DigiLocker OAuth Credentials
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""


# ==============================================================================
# 13. SOCIAL MEDIA PLATFORM APIS
# ==============================================================================
# [REQUIRED for Instagram Connect] Instagram Business Login (Meta Graph API v22.0)
# ⚠️  Instagram Basic Display API was shut down Dec 4 2024 — use Business Login only.
# Setup: Meta for Developers → Your App → Add Product → "Instagram" → "Instagram Business Login"
# Scopes needed: instagram_business_basic
# Redirect URI to whitelist: https://yourdomain.com/api/auth/instagram/callback
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# [OPTIONAL] YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=""


# ==============================================================================
# 14. COMPUTER VISION OCR (CONTACT LEAKAGE DETECTION)
# ==============================================================================
# [OPTIONAL] Google Cloud Vision API Key for OCR scanning of uploaded images/attachments
VISION_API_KEY=""


# ==============================================================================
# 15. CRYPTOGRAPHY, ENCRYPTION & SYSTEM KEYS
# ==============================================================================
# [GENERATE] AES-256-GCM Encryption Key Map for bank details (v1:<64-hex-characters>)
ENCRYPTION_KEYS="v1:YOUR_64_HEX_KEY"
ENCRYPTION_KEY="YOUR_64_HEX_KEY"

# [GENERATE] HMAC Signature Secret for tamper-proof data verification (64 hex chars)
HMAC_KEY="YOUR_64_HEX_HMAC_KEY"

# [GENERATE] Digital Contract Signing Secret (64 hex chars)
CONTRACT_SIGNING_SECRET="generate-with: openssl rand -hex 32"

# [GENERATE] Automated Cron Route Secret (Protects /api/cron/* endpoints)
CRON_SECRET="generate-with: openssl rand -hex 32"

# [GENERATE] System Healthcheck & Metrics Auth Tokens
HEALTHCHECK_SECRET="generate-with: openssl rand -hex 32"
PROMETHEUS_AUTH_TOKEN="generate-with: openssl rand -hex 32"


# ==============================================================================
# 16. ERROR TRACKING & PERFORMANCE MONITORING (SENTRY)
# ==============================================================================
# [OPTIONAL] Sentry DSN for error and performance monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0


# ==============================================================================
# 17. CORPORATE & PLATFORM COMPLIANCE (LEGAL & INVOICING STATEMENTS)
# ==============================================================================
# Used in generated CSV/PDF financial statements, GST invoices, and TDS reports
PLATFORM_GSTIN=""
PLATFORM_CIN=""
PLATFORM_PAN=""
PLATFORM_ADDRESS=""
PLATFORM_EMAIL="support@VyaparMedia.in"
PLATFORM_PHONE="+91-8045678900"
PLATFORM_WEBSITE="https://VyaparMedia.in"


# ==============================================================================
# 18. PLATFORM BUSINESS RULES & THRESHOLDS
# ==============================================================================
PLATFORM_FEE_PERCENTAGE=10
GATEWAY_FEE_PERCENTAGE=2
MIN_WITHDRAWAL_AMOUNT=50000
MAX_WITHDRAWAL_AMOUNT=50000000
NEXT_PUBLIC_MIN_WITHDRAWAL_AMOUNT=50000
NEXT_PUBLIC_MAX_WITHDRAWAL_AMOUNT=50000000


# ==============================================================================
# 19. SHIPROCKET LOGISTICS & SHIPPING API (PRODUCT DEALS)
# ==============================================================================
# Shiprocket API credentials for automated shipping order & AWB generation.
# In local development / testing: If credentials are left empty, the system operates in mock simulation mode.
# In production: SHIPROCKET_EMAIL and SHIPROCKET_PASSWORD are strictly required to create real shipments.
# [CRITICAL SECURITY] In production, SHIPROCKET_WEBHOOK_SECRET MUST be configured; otherwise incoming
# webhooks are rejected to prevent spoofed delivery status updates and unauthorized escrow release.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE=""          # Brand's warehouse/pickup pincode for courier rate estimation
SHIPROCKET_WEBHOOK_SECRET="generate-with: openssl rand -hex 32"


# ==============================================================================
# 20. CLOUD & RUNTIME ENVIRONMENT METADATA (VERCEL / AWS / CI)
# ==============================================================================
# Injected automatically by Vercel / AWS Lambda / CI test runners
VERCEL=""
VERCEL_URL=""
VERCEL_PROJECT_PRODUCTION_URL=""
AWS_LAMBDA_FUNCTION_NAME=""
NEXT_PHASE=""
VITEST=""

